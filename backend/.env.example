# Local development. Copy to backend/.env and edit the PostgreSQL password.
# Create database and user first using pgAdmin or psql (see START_HERE_POSTGRES_ROMAN_URDU.md).
# If password contains @, :, /, #, ? or % then URL-encode it.
APP_ENV=Deployed
DATABASE_URL=
# Test DB MUST be separate from real local data. Tests will destroy tables in the _test DB.
TEST_DATABASE_URL=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_HOURS=12
# Local admin is created interactively using SETUP_LOCAL.bat; leave these blank locally.
ADMIN_EMAIL=
ADMIN_PASSWORD=
AI_ALLOWED=true
AUDIT_AI_PROVIDER=claude
CLAUDE_MODEL=claude-sonnet-5-5
# Paste your Anthropic API key here (starts with sk-ant-). Until then, the audit
# runs deterministic-only (no AI narrative/QA); all counts still work.
ANTHROPIC_API_KEY=
# When true (default), the AI's per-chat category + lead tier become the authoritative
# classification for evaluated chats (old n8n/Gemini style); chats the AI could not
# evaluate keep the rule-based result. Set false to keep classification rule-based.
AUDIT_AI_CLASSIFY=true
# Previous provider (Gemini) kept for reference; unused while AUDIT_AI_PROVIDER=claude.
GEMINI_MODEL=
GEMINI_API_KEY=
# Automatic daily audits (run by the worker service). Defaults: one audit per
# eligible employee (>=1 non-group chat) each day at 18:00 (6 PM) Pakistan time,
# A-Z by name, staggered 20 minutes apart. Manual "Generate Audit" is unaffected.
AUDIT_SCHEDULE_ENABLED=true
AUDIT_SCHEDULE_HOUR=18
AUDIT_SCHEDULE_GAP_MINUTES=20
AUDIT_SCHEDULE_TZ=Asia/Karachi